{% extends 'base.html.twig' %}

{% block main_class %}d-flex align-items-center justify-content-center vh-100{% endblock %}

{% block main %}
    <div class="text-center my-auto" {{ stimulus_controller('mission')}} >
        <div id="prevUrl" data-previous-url="{{ path('app_mission_index') }}" {{ stimulus_target('mission', 'prevUrl') }}></div>
        <h1 class="display-4 text-success fw-bold">{{ 'mission.complete.title'|trans }}</h1>
        {% if message is defined %}
            <h3>{{ message|trans }}</h3>
        {% else %}
        {% endif %}
{#        <p class="lead text-muted my-5">Torna alla lista missioni.</p>#}
        <a href="{{ path('app_mission_index') }}" class="btn btn-success">{{ 'back.to.missions'|trans }}</a>
    </div>
{% endblock %}


