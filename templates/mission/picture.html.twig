{% extends 'base.html.twig' %}

{# this tag only applies to the forms defined in this template #}
{% form_theme form 'bootstrap_5_layout.html.twig' %}

{# @var mission App\Entity\Mission #}

{% block body %}
    <div class="container missions text-center">
        <h1>{{ 'mission.picture.title'|trans({'id': mission.id})}}</h1>
        <h6 class="lead">{{ 'mission.picture.lead'|trans }}</h6>
        <div class="mt-5">
            {{ form_start(form) }}
            {{ form_row(form.description, {
                label: 'image.description',
                attr: { placeholder : 'image.description', rows: '6', class: 'h-100'},
                row_attr: { class: 'form-floating mb-3'}
            }) }}
            {{ form_row(form.imageFile, {
                label: false
            }) }}
            <button type="submit" class="btn-primary btn">{{ 'Send'|trans }}</button>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}

{% block title %}

{% endblock %}

