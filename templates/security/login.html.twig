{% extends 'base.html.twig' %}

{% block main_class %}bg-light d-flex align-items-center justify-content-center vh-100{% endblock %}
{% block title %}Truck26: login{% endblock %}

{% block main %}
    <div class="container">
        <form method="post" class="col-12 col-md-4 mx-auto">
            {% if error %}
                <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            {% if app.user %}
                <div class="mb-3">
                    You are logged in as {{ app.user.userIdentifier }}, <a href="{{ logout_path() }}">Logout</a>
                </div>
            {% endif %}

            <h1 class="h3 mb-3 fw-normal">{{ 'Please sign in'|trans }}</h1>
            <div class="form-floating">
                <input type="text" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="username" required autofocus placeholder="mario">
                <label for="username">Username</label>
            </div>
            <div class="form-floating">
                <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required placeholder="password">
                <label for="password">Password</label>
            </div>
            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

            <div class="form-check text-start my-3">
                <input class="form-check-input" type="checkbox" name="_remember_me" id="_remember_me">
                <label class="form-check-label" for="_remember_me">{{ 'Remember me'|trans }}</label>
            </div>
            <button class="btn btn-primary w-100 py-2" type="submit">{{ 'Sign in'|trans }}</button>
            <p class="mt-5 mb-3 text-body-secondary">© 2026–2033</p>
        </form>
    </div>
{% endblock %}
