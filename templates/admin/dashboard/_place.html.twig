{% if places|length > 0 %}
    <div class="col">
        <div class="card">
            <div class="card-header bg-warning">
                <i class="fa-solid fa-location-dot"></i>
            </div>
            <div class="card-body">
                <h5 class="card-title">{{ 'unmapped.place.coords'|trans }}</h5>
                <a class="card-subtitle text-body-secondary" href="https://nominatim.openstreetmap.org">Check nominatim.openstreetmap.org</a>
                <ul class="mt-3">
                    {% for place in places %}
                        <li class="card-text">
                            <a href="{{ path('admin_place_edit', {entityId: place.id}) }}">{{ place.name }}</a>
                        </li>
                        {% if loop.index == 5 %}...{% endif %}
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>
{% else %}
    <div class="col">
        <div class="card h-100">
            <div class="card-header bg-success">
                <i class="fa-solid fa-location-dot"></i>
            </div>
            <div class="card-body d-flex flex-column">
                <h5 class="card-title">{{ 'all.place.mapped'|trans }}</h5>
                <a class="card-subtitle text-body-secondary" href="https://nominatim.openstreetmap.org">Check nominatim.openstreetmap.org</a>
                <p class="text-center display-6 text-success my-auto"><i class="fa-solid fa-check"></i></p>
            </div>
        </div>
    </div>
{% endif %}
