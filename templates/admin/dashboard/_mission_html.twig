{% if (mission_start|length + mission_pending|length) > 0 %}
    <div class="col">
        <div class="card">
            <div class="card-header bg-danger">
                <i class="fa-solid fa-truck-fast"></i>
            </div>
            <div class="card-body">
                <h5 class="card-title">{{ 'mission.to.manage'|trans }}</h5>
                <a class="card-subtitle text-body-secondary" href="{{ path('admin_mission_management') }}">{{ 'goto.manage'|trans }}</a>
                <ul class="mt-3">
                    {% for mission in mission_start %}
                        <li class="card-text">{{ mission.pickupPlaceName }}</li>
                        {% if loop.index == 5 %}...{% endif %}
                    {% endfor %}
                    {% for mission in mission_pending %}
                        <li class="card-text">{{ mission.deliveryPlaceName }}</li>
                        {% if loop.index == 5 %}...{% endif %}
                    {% endfor %}

                </ul>
            </div>
        </div>
    </div>
{% else %}
    <div class="col">
        <div class="card h-100">
            <div class="card-header bg-success">
                <i class="fa-solid fa-truck-fast"></i>
            </div>
            <div class="card-body d-flex flex-column">
                <h5 class="card-title">{{ 'all.mission.managed'|trans }}</h5>
                <a class="card-subtitle text-body-secondary" href="{{ path('admin_mission_management') }}">{{ 'goto.manage'|trans }}</a>
                <p class="text-center display-6 text-success my-auto"><i class="fa-solid fa-check"></i></p>
            </div>
        </div>
    </div>
{% endif %}
