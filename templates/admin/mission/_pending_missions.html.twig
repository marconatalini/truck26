{% if pending_missions|length > 0 %}
    <div class="accordion" id="missions">
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#delivering" aria-expanded="true" aria-controls="collapseOne">
                    {{ 'delivery'|trans|upper }}
                </button>
            </h2>
            <div id="delivering" class="accordion-collapse collapse show" data-bs-parent="#missions">
                <div class="">
                    {% for mission in pending_missions %}
                        <div class="border border-2 border-success d-flex rounded-2 mb-1"
                            {{ stimulus_target('calendar', 'draggable') }}
                             data-event="{{ mission|json_encode()}}"
                        >

                            <a class="mx-2 my-auto" href="{{ path('admin_mission_detail', {entityId: mission.id}) }}"><i class="fa-regular fa-circle-question"></i></a>
                            <p>{{ mission.plate }} > {{ mission.weight }}kg / {{ mission.area }}mq<br>
                                per {{ mission.deliveryPlaceName}}
                            </p>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
{% else %}
    <h6>{{ 'no.pending.mission'|trans }}</h6>
{% endif %}






