<div class="row row-cols-lg-auto g-3 align-items-center" {{ stimulus_action('calendar', 'renderCalendar', 'input') }}>
    <div class="col-12">
        <div class="form-floating mb-3">
            <select id="vehicleSelect" class="form-select" aria-label="Vehicle select"
                {{ stimulus_target('calendar', 'vehicleChoice') }}>
                {% for vehicle in vehicles %}
                    <option value="{{ vehicle.id }}"
                        data-picking-url="{{ path('admin_mission_picking_vehicle', {vehicle_id: vehicle.id}) }}"
                        data-delivering-url="{{ path('admin_mission_delivering_vehicle', {vehicle_id: vehicle.id}) }}"
                        >{{ vehicle.plate }} {{ vehicle.model }}</option>
                {% else %}
                    <option value="">{{ 'novehicle.avaible'|trans }}</option>
                {% endfor %}
            </select>
            <label for="vehicleSelect">{{ 'VEHICLE'|trans }}</label>
        </div>
    </div>
</div>
