{{ 'VEHICLES'|trans }}:
<div class="form-check form-check-inline mb-2" {{ stimulus_action('calendar', 'renderCalendar', 'input') }}>
{% for vehicle in vehicles %}
    {% set idx = loop.index %}
        <input class="form-check-input" type="radio" name="inlineRadioOptions"
               id="inlineRadio{{ idx }}" value="{{ vehicle.id }}"
               data-picking-url="{{ path('admin_mission_picking_vehicle_mission', {id: vehicle.id}) }}"
               data-delivering-url="{{ path('admin_mission_delivering_vehicle_mission', {id: vehicle.id}) }}"
               {{ stimulus_target('calendar', 'checkbox') }}
            {% if idx === 1 %} checked {% endif %}
        >
        <label class="form-check-label me-5 border-warning" for="inlineRadio{{ idx }}"
        >{{ vehicle.plate }}</label>
{% endfor %}
</div>
